# --- Base de datos ---
# Cadena de conexión de PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/latorre_propiedades?schema=public"

# --- Servidor ---
PORT=4000
NODE_ENV=development
# URL del frontend, para configurar CORS correctamente
CORS_ORIGIN="http://localhost:5173"

# --- Autenticación ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# --- Almacenamiento de fotos ---
# URL pública del backend: se usa para armar los links de las fotos guardadas en disco.
PUBLIC_URL="http://localhost:4000"
# Carpeta donde se guardan las fotos cuando Cloudinary no está configurado (por defecto: backend/uploads)
# UPLOADS_DIR=""

# --- Cloudinary (opcional) ---
# Si estas tres variables están vacías, las fotos se guardan en el disco del servidor
# y se sirven desde /uploads. Completalas para pasar a Cloudinary (compresión + WebP + CDN).
# Crear cuenta gratuita en https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="latorre-propiedades"

# --- Datos de demo ---
# Si es "true", el seed carga 3 propiedades de ejemplo marcadas como demo
SEED_DEMO_DATA="true"
